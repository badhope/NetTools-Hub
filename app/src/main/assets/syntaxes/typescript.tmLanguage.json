<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>TypeScript (Mashang Lite)</string>
	<key>scopeName</key>
	<string>source.ts</string>
	<key>fileTypes</key>
	<array>
		<string>ts</string>
		<string>tsx</string>
	</array>
	<key>patterns</key>
	<array>
		<dict>
			<key>name</key>
			<string>storage.type.ts</string>
			<key>match</key>
			<string>\b(string|number|boolean|any|void|never|unknown|object|symbol|bigint)\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>keyword.other.ts</string>
			<key>match</key>
			<string>\b(interface|type|enum|implements|readonly|namespace|declare|as)\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>entity.name.type.ts</string>
			<key>match</key>
			<string>\b[A-Z][A-Za-z0-9_]*\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>comment.line.double-slash.ts</string>
			<key>match</key>
			<string>//.*$</string>
		</dict>
		<dict>
			<key>name</key>
			<string>comment.block.ts</string>
			<key>begin</key>
			<string>/\*</string>
			<key>end</key>
			<string>\*/</string>
		</dict>
		<dict>
			<key>name</key>
			<string>string.quoted.double.ts</string>
			<key>begin</key>
			<string>"</string>
			<key>end</key>
			<string>"</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.character.escape.ts</string>
					<key>match</key>
					<string>\\.</string>
				</dict>
			</array>
		</dict>
		<dict>
			<key>name</key>
			<string>string.quoted.single.ts</string>
			<key>begin</key>
			<string>'</string>
			<key>end</key>
			<string>'</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.character.escape.ts</string>
					<key>match</key>
					<string>\\.</string>
				</dict>
			</array>
		</dict>
		<dict>
			<key>name</key>
			<string>string.template.ts</string>
			<key>begin</key>
			<string>`</string>
			<key>end</key>
			<string>`</string>
		</dict>
		<dict>
			<key>name</key>
			<string>constant.numeric.ts</string>
			<key>match</key>
			<string>\b0[xX][0-9a-fA-F]+\b|\b\d+(\.\d+)?([eE][-+]?\d+)?\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>constant.language.ts</string>
			<key>match</key>
			<string>\b(true|false|null|undefined|NaN|Infinity|this)\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>storage.type.ts</string>
			<key>match</key>
			<string>\b(var|let|const|function|class)\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>keyword.control.ts</string>
			<key>match</key>
			<string>\b(return|if|else|for|while|do|switch|case|default|break|continue|new|typeof|instanceof|delete|in|of|try|catch|finally|throw|yield|async|await)\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>support.function.ts</string>
			<key>match</key>
			<string>\b(console|Math|JSON|Object|Array|String|Number|Boolean|parseInt|parseFloat|isNaN|isFinite)\b</string>
		</dict>
		<dict>
			<key>name</key>
			<string>entity.name.function.ts</string>
			<key>match</key>
			<string>\b([a-zA-Z_$][\w$]*)\s*(?=\()</string>
		</dict>
	</array>
</dict>
</plist>
