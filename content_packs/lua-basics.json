    "exercise": {
      "title": "累加器",
      "brief": "实现 sum_to(n)：返回 1 到 n 的和（n<1 返回 0）。",
      "starterCode": "function sum_to(n)\n  \nend\n\nprint(sum_to(10))",
      "hint": "local s = 0 然后 for i = 1, n do s = s + i end。",
      "tests": [
